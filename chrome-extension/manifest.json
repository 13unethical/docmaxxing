{
  "manifest_version": 3,
  "name": "Veil",
  "version": "1.2.8",
  "description": "Study overlay: explain selected text, crop diagrams, and humanize a highlight with Control+H.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite", "clipboardRead"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Veil",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "https://docmaxxing.com/*",
      "https://www.docmaxxing.com/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "quick-humanize": {
      "suggested_key": {
        "default": "Alt+H",
        "mac": "MacCtrl+H"
      },
      "description": "Humanize selected text"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
